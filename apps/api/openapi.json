  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/dashboard": {
      "get": {
        "description": "Everything the dashboard shows: current month, history, future, and the year overview.",
        "operationId": "dashboard_overview",
        "parameters": [
          {
            "description": "Property ID, or 'all' for every property",
            "in": "query",
            "name": "property",
            "required": false,
            "schema": {
              "default": "all",
              "description": "Property ID, or 'all' for every property",
              "title": "Property",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "past_months",
            "required": false,
            "schema": {
              "default": 12,
              "maximum": 24,
              "minimum": 1,
              "title": "Past Months",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "future_months",
            "required": false,
            "schema": {
              "default": 6,
              "maximum": 24,
              "minimum": 0,
              "title": "Future Months",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DashboardResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Overview"
      }
    },
    "/api/dashboard/bootstrap": {
      "get": {
        "description": "Account, properties, and today's date in the account timezone.",
        "operationId": "dashboard_bootstrap",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BootstrapResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Bootstrap"
      }
    },
    "/api/health": {
      "get": {
        "description": "The app's status and each dependency's: whether Mistral is configured, whether each checked\nservice answers. ``degraded`` when one does not; the response is 200 either way.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Report dependency status; always answers 200"
      }
    }
  }
